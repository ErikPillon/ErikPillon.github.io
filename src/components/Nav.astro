---
import { nav, site } from '../site';
import ThemeToggle from './ThemeToggle.astro';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;

const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<header class="nav">
  <div class="wrap nav__inner">
    <div class="brand">
      <a href="/" class="wordmark" aria-label={`${site.title} — home`}>
        <span class="wordmark__name">Erik Pillon</span>
      </a>
      <span class="wordmark__dot" aria-hidden="true">·</span>
      {/* Unlabelled on purpose. It goes somewhere. */}
      <a href="/∮/" class="wordmark__meta" aria-label="Colophon">∮</a>
    </div>

    <nav class="nav__links" aria-label="Main">
      {
        nav
          .filter((item) => !(home && item.href === '/'))
          .map((item) => (
            <a href={item.href} class="nav__link" aria-current={isCurrent(item.href) ? 'page' : undefined}>
              {item.label}
            </a>
          ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--rule);
  }

  .nav__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.75rem;
  }

  .brand {
    display: inline-flex;
    align-items: baseline;
    gap: 0.4rem;
  }

  .wordmark {
    text-decoration: none;
    font-family: var(--font-display);
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    font-variation-settings: 'SOFT' 20, 'WONK' 0;
    transition: font-variation-settings 0.35s ease;
  }

  /* A small piece of showing-off: the wordmark goes wonky on hover. */
  .wordmark:hover {
    font-variation-settings: 'SOFT' 90, 'WONK' 1;
  }

  .wordmark__name {
    white-space: nowrap;
  }

  .wordmark__dot,
  .wordmark__meta {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.85rem;
  }

  .wordmark__meta {
    opacity: 0.7;
    text-decoration: none;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .wordmark__meta:hover {
    opacity: 1;
    transform: translateY(-1px) rotate(-8deg);
  }

  .nav__links {
    display: flex;
    align-items: center;
    gap: clamp(0.75rem, 2.5vw, 1.75rem);
  }

  .nav__link {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    text-transform: lowercase;
    color: var(--ink-3);
    text-decoration: none;
    padding-block: 0.35rem;
    border-bottom: 1px solid transparent;
    transition: color 0.15s ease, border-color 0.15s ease;
  }

  .nav__link:hover {
    color: var(--ink);
  }

  .nav__link[aria-current='page'] {
    color: var(--ink);
    border-bottom-color: var(--accent);
  }

  @media (max-width: 30rem) {
    .wordmark {
      font-size: 0.95rem;
    }

    .wordmark__dot,
    .wordmark__meta {
      display: none;
    }

    .nav__links {
      gap: 0.8rem;
    }

    .nav__link {
      font-size: 0.7rem;
      letter-spacing: 0.03em;
    }
  }
</style>
