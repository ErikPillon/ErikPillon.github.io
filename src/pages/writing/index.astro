---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import SectionHead from '../../components/SectionHead.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts } from '../../lib/posts';

const posts = await getPosts();
const elsewhere = (await getCollection('elsewhere')).sort((a, b) => a.data.order - b.data.order);

const years = [...new Set(posts.map((p) => p.data.date.getFullYear()))].sort((a, b) => b - a);
const bookNotes = posts.filter((p) => p.data.book).length;
---

<Base
  title="Writing"
  description="Book notes, write-ups of papers and the odd technical piece — plus where the rest of my writing lives."
>
  <section class="section section--flush page-head">
    <div class="wrap">
      <p class="label">Writing</p>
      <h1 class="display page-head__title">Notes on what I've been reading.</h1>
      <p class="lede">
        Mostly book notes and write-ups of papers. I write them for myself first, so I can find
        things again later. If one of them is any good it should save you the book — and if it
        isn't, it should at least tell you whether the book is worth an evening.
      </p>
      <p class="counts mono">
        <span>{posts.length} pieces</span>
        <span>{bookNotes} book notes</span>
        <span>{years.at(-1)}–{years[0]}</span>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead num="01" title="On this site" />
      <div class="posts">
        {posts.map((post) => <PostCard post={post} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead num="02" title="Everywhere else" />
      <p class="comment section__note">
        the newsletter, the dashboards, and a couple of places that came before this site
      </p>

      <div class="grid">
        {
          elsewhere.map((item) => (
            <a class="ext" href={item.data.link} target="_blank" rel="noopener">
              <p class="ext__kind mono">
                {item.data.kind} <span class="ext__host">/ {item.data.host}</span>
              </p>
              <h3 class="ext__name">{item.data.name}</h3>
              <p class="ext__desc">{item.data.description}</p>
              <span class="ext__go mono">
                Visit <span aria-hidden="true">↗</span>
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .page-head {
    padding-block: clamp(3rem, 8vw, 5rem) clamp(1.5rem, 3vw, 2.5rem);
  }

  .page-head__title {
    font-size: clamp(2.2rem, 6vw, 3.9rem);
    margin: 1.2rem 0 1.4rem;
    max-width: 18ch;
  }

  .counts {
    display: flex;
    flex-wrap: wrap;
    gap: 1.75rem;
    margin-top: 1.75rem;
    padding-top: 1.25rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
  }

  .section__note {
    margin-top: -1.25rem;
    margin-bottom: 2rem;
  }

  .posts {
    display: grid;
    border-bottom: 1px solid transparent;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 16rem), 1fr));
    gap: 1.25rem;
  }

  .ext {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    padding: 1.15rem 1.25rem 1.1rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius);
    background: var(--surface);
    text-decoration: none;
    transition: border-color 0.2s ease, transform 0.2s cubic-bezier(0.2, 0.7, 0.3, 1), box-shadow 0.2s ease;
  }

  .ext:hover {
    border-color: var(--rule-strong);
    transform: translateY(-2px);
    box-shadow: var(--shadow);
  }

  .ext__kind {
    font-size: 0.66rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-ink);
  }

  .ext__host {
    color: var(--ink-3);
  }

  .ext__name {
    font-size: 1.1rem;
  }

  .ext:hover .ext__name {
    color: var(--accent-ink);
  }

  .ext__desc {
    font-size: 0.9rem;
    line-height: 1.6;
    color: var(--ink-2);
    flex: 1;
  }

  .ext__go {
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-3);
    padding-top: 0.85rem;
    margin-top: 0.25rem;
    border-top: 1px dotted var(--rule);
  }

  .ext:hover .ext__go {
    color: var(--accent);
  }
</style>
