---
import { analytics } from '../site';

/**
 * Google Analytics 4.
 *
 * Loads on every page view, for every visitor. Only included in production
 * builds, so local development never shows up as traffic.
 *
 * Set `measurementId` to '' in src/site.ts to remove analytics from the site
 * entirely — no script, no cookies, no requests to Google.
 */
const id = analytics.measurementId;
const enabled = import.meta.env.PROD && Boolean(id);
---

{
  enabled && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${id}`} />
      <script is:inline define:vars={{ id }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = function () {
          window.dataLayer.push(arguments);
        };
        window.gtag('js', new Date());
        window.gtag('config', id);
      </script>
    </>
  )
}
